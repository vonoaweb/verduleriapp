# ===========================================
# VerduleriApp Backend - Variables de Entorno
# ===========================================
# Copia este archivo como .env y completa los valores

# Servidor
PORT=3001
NODE_ENV=development

# Base de Datos (Supabase PostgreSQL)
# Ve a: https://supabase.com → Tu proyecto → Settings → Database
DATABASE_URL="postgresql://postgres.[TU-PROJECT-REF]:[TU-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[TU-PROJECT-REF]:[TU-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Supabase (para Auth y Storage)
# Ve a: https://supabase.com → Tu proyecto → Settings → API
SUPABASE_URL="https://[TU-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="tu-anon-key-aqui"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key-aqui"

# JWT (para autenticacion propia si no usas Supabase Auth)
JWT_SECRET="tu-secreto-super-seguro-cambiame-en-produccion"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Frontend URL (para CORS)
FRONTEND_URL="http://localhost:5173"

# Cloudinary (para imagenes - opcional, puedes usar Supabase Storage)
# CLOUDINARY_CLOUD_NAME="tu-cloud-name"
# CLOUDINARY_API_KEY="tu-api-key"
# CLOUDINARY_API_SECRET="tu-api-secret"

# ===========================================
# BOT DE WHATSAPP CON IA (Fase 1)
# ===========================================

# 1) WhatsApp Cloud API
# Ve a: https://developers.facebook.com → Tu app → WhatsApp → API Setup
# (Meta da un número de PRUEBA gratis para empezar sin verificar nada)
# WHATSAPP_PHONE_ID="tu-phone-id"
# WHATSAPP_ACCESS_TOKEN="tu-access-token"
# WHATSAPP_VERIFY_TOKEN="verduleriapp-webhook-token"   # tú lo inventas, debe coincidir en Meta

# 2) Google Gemini (cerebro del bot - free tier)
# Ve a: https://aistudio.google.com → Get API Key (gratis)
# GEMINI_API_KEY="tu-api-key-de-gemini"
# GEMINI_MODEL="gemini-2.0-flash"   # opcional, este es el valor por defecto
